{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@front/*": ["node_modules/@vue-devtools/app-frontend/src/*"],
      "@back/*": ["node_modules/@vue-devtools/app-backend/src/*"],
      "@utils/*": ["node_modules/@vue-devtools/shared-utils/src/*"]
    },
    "types": ["chrome"]
  },
  "include": ["src/**/*", "popups/**/*", "vite.config.js", "*.d.ts"],
  "exclude": ["node_modules", "build"]
}
