{
  "name": "@vue-devtools/shell-chrome",
  "version": "0.0.0",
  "scripts": {
    "dev:chrome": "webpack --watch",
    "build": "cross-env NODE_ENV=production webpack --progress --stats=errors-only && npm run zip",
    "zip": "zip -r ../shell-chrome.zip ./* -x 'node_modules/*'"
  },
  "dependencies": {
    "@vue-devtools/app-backend": "workspace:*",
    "@vue-devtools/app-frontend": "workspace:*",
    "@vue-devtools/shared-utils": "workspace:*",
    "@yuhufe/browser-bridge": "^0.1.1"
  },
  "devDependencies": {
    "@vue-devtools/build-tools": "workspace:*",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}
