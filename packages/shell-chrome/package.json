{
  "name": "@vue-devtools/shell-chrome",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:chrome": "cross-env NODE_ENV=development vite build --watch",
    "build": "rm -rf ./build && cross-env NODE_ENV=production vite build && npm run zip",
    "zip": "cd build && zip -r ../shell-chrome.zip ."
  },
  "dependencies": {
    "@vue-devtools/app-backend": "workspace:*",
    "@vue-devtools/app-frontend": "workspace:*",
    "@vue-devtools/shared-utils": "workspace:*",
    "@yuhufe/browser-bridge": "^0.1.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue2": "^2.3.1",
    "vite": "^7.0.0",
    "vite-plugin-web-extension": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/chrome": "^0.1.0"
  }
}
