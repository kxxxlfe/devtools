{
  "name": "@vue/devtools",
  "version": "5.4.14",
  "description": "StandAlone vue-devtools",
  "repository": {
    "url": "https://github.com/vuejs/vue-devtools.git",
    "type": "git"
  },
  "bin": {
    "vue-devtools": "./bin.js"
  },
  "main": "index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "start": "node bin.js",
    "dev": "webpack --watch --hide-modules",
    "build": "webpack",
    "prepublishOnly": "npm run build"
  },
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cross-spawn": "^5.1.0",
    "electron": "^7.0.0",
    "express": "^4.16.2",
    "ip": "^1.1.5",
    "socket.io": "^2.0.4"
  },
  "devDependencies": {
    "@vue-devtools/app-backend": "workspace:*",
    "@vue-devtools/app-frontend": "workspace:*",
    "@vue-devtools/build-tools": "workspace:*",
    "@vue-devtools/shared-utils": "workspace:*",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  }
}
